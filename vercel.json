{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "env": {
    "AI_OFFICE_GEMINI_MODEL": "gemini-3.8-flash",
    "AI_OFFICE_GEMINI_ECONOMY_MODEL": "gemini-3.5-flash-lite",
    "GEMINI_MODEL": "gemini-3.8-flash",
    "XIAOZHI_PROTOCOL_VERSION": "1"
  },
  "builds": [
    { "src": "api/app.ts", "use": "@vercel/node" },
    { "src": "api/asset.ts", "use": "@vercel/node" },
    { "src": "api/drive-brain-gateway.ts", "use": "@vercel/node" },
    { "src": "api/health-legacy-retired.ts", "use": "@vercel/node" },
    { "src": "api/health.ts", "use": "@vercel/node" },
    { "src": "api/image-gateway.ts", "use": "@vercel/node" },
    { "src": "api/ingest-gateway.ts", "use": "@vercel/node" },
    { "src": "api/provider-check.ts", "use": "@vercel/node" },
    { "src": "api/proxy-gateway.ts", "use": "@vercel/node" },
    { "src": "api/research-gateway.ts", "use": "@vercel/node" },
    { "src": "api/research-legacy-retired.ts", "use": "@vercel/node" },
    { "src": "api/selftest.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/", "dest": "/api/app.ts", "headers": { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin", "X-Frame-Options": "DENY", "Permissions-Policy": "camera=(), microphone=(self), geolocation=(self)" } },
    { "src": "/api/health", "dest": "/api/health.ts", "headers": { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin", "X-Frame-Options": "DENY", "Permissions-Policy": "camera=(), microphone=(self), geolocation=(self)" } },
    { "src": "/api/provider-check", "dest": "/api/provider-check.ts", "headers": { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin", "X-Frame-Options": "DENY", "Permissions-Policy": "camera=(), microphone=(self), geolocation=(self)" } },
    { "src": "/api/selftest", "dest": "/api/selftest.ts", "headers": { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin", "X-Frame-Options": "DENY", "Permissions-Policy": "camera=(), microphone=(self), geolocation=(self)" } },
    { "src": "/api/health-v17", "dest": "/api/health-legacy-retired.ts", "headers": { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin", "X-Frame-Options": "DENY", "Permissions-Policy": "camera=(), microphone=(self), geolocation=(self)" } },
    { "src": "/api/ws-xiaozhi", "dest": "/api/research-legacy-retired.ts?kind=voice", "headers": { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin", "X-Frame-Options": "DENY", "Permissions-Policy": "camera=(), microphone=(self), geolocation=(self)" } },
    { "src": "/api/drive-brain", "dest": "/api/drive-brain-gateway.ts", "headers": { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin", "X-Frame-Options": "DENY", "Permissions-Policy": "camera=(), microphone=(self), geolocation=(self)" } },
    { "src": "/api/research", "dest": "/api/research-gateway.ts", "headers": { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin", "X-Frame-Options": "DENY", "Permissions-Policy": "camera=(), microphone=(self), geolocation=(self)" } },
    { "src": "/api/research-v28", "dest": "/api/research-legacy-retired.ts", "headers": { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin", "X-Frame-Options": "DENY", "Permissions-Policy": "camera=(), microphone=(self), geolocation=(self)" } },
    { "src": "/api/research-v29", "dest": "/api/research-legacy-retired.ts", "headers": { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin", "X-Frame-Options": "DENY", "Permissions-Policy": "camera=(), microphone=(self), geolocation=(self)" } },
    { "src": "/api/research-v30", "dest": "/api/research-legacy-retired.ts", "headers": { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin", "X-Frame-Options": "DENY", "Permissions-Policy": "camera=(), microphone=(self), geolocation=(self)" } },
    { "src": "/api/research-v31", "dest": "/api/research-legacy-retired.ts", "headers": { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin", "X-Frame-Options": "DENY", "Permissions-Policy": "camera=(), microphone=(self), geolocation=(self)" } },
    { "src": "/api/proxy", "dest": "/api/proxy-gateway.ts", "headers": { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin", "X-Frame-Options": "DENY", "Permissions-Policy": "camera=(), microphone=(self), geolocation=(self)" } },
    { "src": "/api/image", "dest": "/api/image-gateway.ts", "headers": { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin", "X-Frame-Options": "DENY", "Permissions-Policy": "camera=(), microphone=(self), geolocation=(self)" } },
    { "src": "/api/ingest", "dest": "/api/ingest-gateway.ts", "headers": { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin", "X-Frame-Options": "DENY", "Permissions-Policy": "camera=(), microphone=(self), geolocation=(self)" } },
    { "src": "/manifest.webmanifest", "dest": "/api/asset.ts?path=public/manifest.webmanifest", "headers": { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin", "X-Frame-Options": "DENY", "Permissions-Policy": "camera=(), microphone=(self), geolocation=(self)", "Content-Type": "application/manifest+json; charset=utf-8" } },
    { "src": "/sw.js", "dest": "/api/asset.ts?path=public/sw.js", "headers": { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin", "X-Frame-Options": "DENY", "Permissions-Policy": "camera=(), microphone=(self), geolocation=(self)", "Cache-Control": "public, max-age=0, must-revalidate", "Service-Worker-Allowed": "/" } },
    { "src": "/icons/(.*)", "dest": "/api/asset.ts?path=public/icons/$1", "headers": { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin", "X-Frame-Options": "DENY", "Permissions-Policy": "camera=(), microphone=(self), geolocation=(self)" } },
    { "src": "/src/(.*)", "dest": "/api/asset.ts?path=src/$1", "headers": { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin", "X-Frame-Options": "DENY", "Permissions-Policy": "camera=(), microphone=(self), geolocation=(self)" } }
  ]
}

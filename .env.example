# A.I Văn phòng — Vercel provider configuration
# Never commit real secret values. Add secrets in Vercel Project Settings > Environment Variables.

# Gemini — REQUIRED for reasoning + Google Search grounding
GEMINI_API_KEY=
# Non-secret production default.
AI_OFFICE_GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash
# Optional economy route.
AI_OFFICE_GEMINI_ECONOMY_MODEL=gemini-3.5-flash-lite

# Google Drive Brain — choose ONE provider. Do not fill both unless you want failover.
# Option A (recommended): Google Service Account with Viewer access to the A.I Văn phòng root folder.
# Store the complete JSON as one encrypted Vercel environment variable.
# Runtime only requests https://www.googleapis.com/auth/drive.readonly.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=

# Option B: Apps Script Bridge.
# URL must be the deployed /exec Web App URL; token must exactly match Script Property DRIVE_BRAIN_TOKEN.
DRIVE_BRAIN_BRIDGE_URL=
DRIVE_BRAIN_TOKEN=

# XiaoZhi — OPTIONAL external realtime upstream.
# Browser voice remains the fallback when upstream is unavailable.
XIAOZHI_WS_URL=
# Recommended when upstream auth is enabled. Sent as Authorization: Bearer <token>.
XIAOZHI_WS_TOKEN=
# Protocol default used by the XiaoZhi WebSocket handshake.
XIAOZHI_PROTOCOL_VERSION=1
# Optional stable identifiers. If omitted, the bridge generates per-connection IDs.
XIAOZHI_CLIENT_ID=
XIAOZHI_DEVICE_ID=

# Optional Google Workspace write/actions provider flag.
# This is independent from the readonly Drive Brain provider above.
GOOGLE_WORKSPACE_ENABLED=false

# A.I Văn phòng — Vercel provider configuration
# Never commit real secret values. Add secrets in Vercel Project Settings > Environment Variables.

# Gemini — REQUIRED for Gemini reasoning
GEMINI_API_KEY=
# Non-secret default. v1.8.1 falls back to gemini-2.5-flash when omitted.
GEMINI_MODEL=gemini-2.5-flash

# XiaoZhi — REQUIRED for external realtime upstream
# Production value must be your own/private endpoint, normally:
# wss://your-domain.example/xiaozhi/v1/
XIAOZHI_WS_URL=
# Recommended when upstream auth is enabled. Sent as Authorization: Bearer <token>.
XIAOZHI_WS_TOKEN=
# Protocol default used by the XiaoZhi WebSocket handshake.
XIAOZHI_PROTOCOL_VERSION=1
# Optional stable identifiers. If omitted, the bridge generates per-connection IDs.
XIAOZHI_CLIENT_ID=
XIAOZHI_DEVICE_ID=

# Optional future Google Workspace provider flag
GOOGLE_WORKSPACE_ENABLED=false
